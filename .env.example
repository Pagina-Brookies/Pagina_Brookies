# Copia este archivo como .env y completa los valores. El archivo .env NUNCA se sube al repositorio.
PORT=3000
NODE_ENV=development

# Base de datos MySQL (local o Aiven)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Aiven exige conexión con SSL. Usa true y entrega el certificado CA de una de estas dos formas:
#   DB_SSL_CA          ruta a un archivo .pem (por ejemplo ./ca.pem)
#   DB_SSL_CA_CONTENT  el contenido del certificado (útil en Render)
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_CONTENT=
