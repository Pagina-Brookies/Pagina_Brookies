BT 1 0 0 1 6 144.2 Tm /F4 7 Tf 8.4 TL (// 1\) Reservar al pasar a Webpay \(transacci\363n\)) Tj T* (for \(const n of necesita\) {     // cantidad de cada insumo = receta x unidades del carrito) Tj T* (  const res = s.insumos.updateOne\() Tj T* (    { _id: n.insumo_id, $expr: { $gte: [ { $subtract: ["$stock_actual", "$stock_reservado"] }, n.cantidad ] } },) Tj T* (    { $inc: { stock_reservado: n.cantidad } }\);) Tj T* (  if \(res.modifiedCount === 0\) throw new Error\("Stock insuficiente"\);       // pantalla 08) Tj T* (}) Tj T* (s.reservas.insertOne\({ _id: idReserva, items: carrito, insumos: necesita, estado: "activa",) Tj T* (                       expira_en: new Date\(Date.now\(\) + 10 * 60 * 1000\) }\);) Tj T*  T* (// 2\) Pago aprobado \(transacci\363n\): se descuenta lo reservado y se crea el pedido) Tj T* (const r = s.reservas.findOneAndUpdate\({ _id: idReserva, estado: "activa", expira_en: { $gt: new Date\(\) } },) Tj T* (                                      { $set: { estado: "pagada" } }\);) Tj T* (if \(!r\) throw new Error\("Reserva vencida: se anula el cobro en Webpay"\);) Tj T* (for \(const n of r.insumos\)) Tj T* (  s.insumos.updateOne\({ _id: n.insumo_id }, { $inc: { stock_actual: -n.cantidad, stock_reservado: -n.cantidad } }\);) Tj T*  T* (// 3\) Pago rechazado o reserva vencida: se devuelve stock_reservado y la reserva queda "liberada") Tj T* ET
